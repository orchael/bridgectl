{
  "name": "bridgectl",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "Pinned local AI agent CLIs for bridgectl",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:agents": "bash ./scripts/setup_ai_agents.sh",
    "build:ts": "corepack pnpm --dir examples/web/ui run build",
    "build:docs": "corepack pnpm --dir docs run build",
    "lint:ts": "eslint \"examples/web/ui/src/**/*.{ts,tsx}\"",
    "test:ts": "echo 'no ts tests'",
    "test:ts:coverage": "echo 'no ts tests'",
    "verify:ts": "corepack pnpm run build:ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.246",
    "@openai/codex": "0.149.1",
    "opencode-ai": "1.18.23"
  }
}
